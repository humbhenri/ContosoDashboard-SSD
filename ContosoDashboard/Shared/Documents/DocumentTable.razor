@using ContosoDashboard.Models
@using ContosoDashboard.Services

@if (Items.Count == 0)
{
    <p class="text-muted mb-0">@EmptyMessage</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    @foreach (var (label, field) in SortableColumns)
                    {
                        <th>
                            @if (OnSort.HasDelegate)
                            {
                                <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold" @onclick="() => OnSort.InvokeAsync(field)">
                                    @label
                                    @if (SortBy == field)
                                    {
                                        <i class="bi @(Descending ? "bi-caret-down-fill" : "bi-caret-up-fill") ms-1"></i>
                                    }
                                </button>
                            }
                            else
                            {
                                @label
                            }
                        </th>
                    }
                    <th>Project</th>
                    @if (ShowUploader)
                    {
                        <th>Uploaded By</th>
                    }
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr @key="item.DocumentId">
                        <td><strong>@item.Title</strong></td>
                        <td><span class="badge bg-secondary">@item.Category</span></td>
                        <td>@item.UploadedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                        <td>@FormatSize(item.FileSizeBytes)</td>
                        <td>@(item.ProjectName ?? "—")</td>
                        @if (ShowUploader)
                        {
                            <td>@item.UploaderName</td>
                        }
                        <td class="text-end text-nowrap">
                            @* download attribute keeps Blazor from intercepting the link *@
                            <a class="btn btn-sm btn-outline-primary" href="/documents/@item.DocumentId/download" download
                               title="Download" aria-label="Download @item.Title">
                                <i class="bi bi-download"></i>
                            </a>
                            @if (item.CanEdit && OnEdit.HasDelegate)
                            {
                                <button class="btn btn-sm btn-outline-secondary ms-1" title="Edit" aria-label="Edit @item.Title"
                                        @onclick="() => OnEdit.InvokeAsync(item)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            }
                            @if (item.CanDelete && OnDelete.HasDelegate)
                            {
                                <button class="btn btn-sm btn-outline-danger ms-1" title="Delete" aria-label="Delete @item.Title"
                                        @onclick="() => OnDelete.InvokeAsync(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public List<DocumentListItem> Items { get; set; } = new();

    [Parameter]
    public string EmptyMessage { get; set; } = "No documents found.";

    [Parameter]
    public bool ShowUploader { get; set; }

    [Parameter]
    public DocumentSortField? SortBy { get; set; }

    [Parameter]
    public bool Descending { get; set; }

    [Parameter]
    public EventCallback<DocumentSortField> OnSort { get; set; }

    [Parameter]
    public EventCallback<DocumentListItem> OnEdit { get; set; }

    [Parameter]
    public EventCallback<DocumentListItem> OnDelete { get; set; }

    private static readonly (string Label, DocumentSortField Field)[] SortableColumns =
    {
        ("Title", DocumentSortField.Title),
        ("Category", DocumentSortField.Category),
        ("Uploaded", DocumentSortField.UploadedDate),
        ("Size", DocumentSortField.FileSize)
    };

    public static string FormatSize(long bytes)
    {
        const double kb = 1024;
        const double mb = kb * 1024;
        if (bytes >= mb)
        {
            return $"{bytes / mb:0.#} MB";
        }
        return bytes >= kb ? $"{bytes / kb:0.#} KB" : $"{bytes} B";
    }
}
